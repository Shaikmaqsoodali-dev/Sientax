# Neon Postgres (use pooled connection string)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth
BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Public site URL used in verification / reset email links (production: https://your-domain.com)
APP_URL=http://localhost:3000
# Stable across Vercel builds — prevents "Server Action was not found" after deploy
# Generate: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Field encryption for SSN / ITIN (32-byte hex or base64)
FIELD_ENCRYPTION_KEY=

# Cloudflare R2 (S3-compatible)
# Account ID from dash → R2 → Overview
# Endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Create keys: R2 → Manage API Tokens → Object Read & Write (scope to sientax-docs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sientax-docs
R2_PUBLIC_URL=
R2_ENDPOINT=

# Email
RESEND_API_KEY=
EMAIL_FROM=Sientax <noreply@sientax.com>

# Payments (no card processors in v1)
ZELLE_ID=

# Optional local file fallback when R2 is unset
UPLOAD_DIR=./.uploads
